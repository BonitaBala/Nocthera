{
  "name": "nocthera",
  "version": "1.1.0",
  "description": "Nocthera - Discord Management Bot",
  "author": "JD Gabriel",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/app.js",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate": "node --input-type=module -e \"import validator from './src/core/architectureValidator.js'; process.exitCode=validator.run()?0:1\"",
    "deploy": "npm start"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discordjs",
    "nocthera",
    "moderation",
    "security"
  ],
  "dependencies": {
    "@discordjs/builders": "^1.13.0",
    "@discordjs/rest": "^2.6.0",
    "@discordjs/voice": "^0.19.2",
    "@iamtraction/play-dl": "^2.0.1",
    "chalk": "^5.6.2",
    "discord-api-types": "^0.38.22",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "ffmpeg-static": "^5.3.0",
    "luxon": "^3.7.2",
    "opusscript": "^0.1.1",
    "pg": "^8.16.3",
    "winston": "^3.17.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  },
  "allowScripts": {
    "ffmpeg-static": true
  }
}
